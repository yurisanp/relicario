{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relicário",
  "identifier": "io.github.yurisanp.relicario",
  "mainBinaryName": "relicario-app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Relicário",
        "width": 1180,
        "height": 780,
        "minWidth": 420,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Saves dos seus jogos em todas as máquinas",
    "longDescription": "Guarda o histórico dos saves e leva o save certo para cada máquina, para jogos sem nuvem da loja.",
    "licenseFile": null
  }
}
